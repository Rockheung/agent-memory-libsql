# memory-core (standalone). Mac 검증본과 동일 구성, 경로만 컨테이너 기준.
deployMode: standalone
stateBackend: local

server:
  port: 8420
  host: 0.0.0.0

data:
  baseDir: /data/tdai-memory

llm:
  baseUrl: "${PROXY_UPSTREAM_URL}"
  apiKey: "${PROXY_UPSTREAM_API_KEY}"   # cliproxy api-key (.env 에서 주입)
  model: "gpt-5.6-sol-low"      # A/B 결과 (docs/06-M0-RESULT.md F11)
  maxTokens: 32000
  timeoutMs: 300000

memory:
  promptMode: chat
  capture: { enabled: true }
  extraction:
    enabled: true
    enableDedup: true
    maxMemoriesPerSession: 20
  persona:
    triggerEveryN: 50
    maxScenes: 15
  pipeline:
    everyNConversations: 5
    enableWarmup: true
    l1IdleTimeoutSeconds: 600
    l2DelayAfterL1Seconds: 90
    l2MinIntervalSeconds: 900
    l2MaxIntervalSeconds: 3600
  recall:
    enabled: true
    maxResults: 5
    scoreThreshold: 0.3
    strategy: hybrid
    timeoutMs: 5000
  # L0/L1 + 벡터 + Skill 을 Turso 로. 접속 정보는 TDAI_STORE_LIBSQL_* env 로 주입된다
  # (config.ts 파서가 env 를 폴백으로 읽는다).
  storeBackend: libsql
  embedding:
    enabled: true
    provider: openai
    baseUrl: "${EMBED_BASE_URL}"   # oci-ko 로컬 ollama (기본). 홈랩 dgx 로 되돌리려면 .env 에서 바꾼다
    apiKey: "ollama"
    model: "bge-m3"
    dimensions: 1024
    sendDimensions: false        # BGE-M3 는 dimensions 파라미터를 400 으로 거부
    timeoutMs: 30000
    recallTimeoutMs: 15000       # oci-ko → dgx LAN 경유 감안

# Skill — 재사용 가능한 절차를 대화에서 추출/보관한다 (4대 자산 중 하나).
# 본문은 Turso skills 테이블에, files/ 첨부는 오브젝트 스토리지에 간다.
skill:
  enabled: true
  routing: { mode: bm25, searchTopK: 20 }
  extraction:
    enabled: true
    maxIterations: 16
    queue:
      backend: local
      keyPrefix: tdai
      resultTtlSeconds: 86400
      lockTtlMs: 600000
      maxRetries: 2
      retryBackoffsMs: [5000, 15000]
  resources:
    maxResourceSizeBytes: 5000000
