# ── 엣지 ──
EDGE_PORT=8090
AGENT_SOURCE=codebuddy      # MemoryProxy 가 아는 값 중 택1:
                            # claude-code | codebuddy | workbuddy | codex | hermes | openclaw
                            # BrowserOS 는 목록에 없으므로 하나를 사칭한다 (공식 문서 권장)
SPACE_ID=default

# ── 커널 인증 ── openssl rand -hex 32
GATEWAY_API_KEY=REPLACE_ME

# ── 상위 LLM (cliproxy) ──
# UPSTREAM_BASE: 엣지가 직결 경로에 쓴다. /v1 을 붙이지 말 것 (엣지가 이어붙임)
UPSTREAM_BASE=http://10.77.0.4:8317
# PROXY_UPSTREAM_URL: memory-proxy 가 쓴다. 이쪽은 /v1 포함
PROXY_UPSTREAM_URL=http://10.77.0.4:8317/v1
PROXY_UPSTREAM_API_KEY=REPLACE_ME

# ── 정체성 ── bootstrap.sh 실행 후 출력값을 채운다
TEAM_ID=
AGENT_ID=
TASK_ID=

# ── 이미지 ──
MEMORY_CORE_IMAGE=agentmemory/memory-core:latest
MEMORY_PROXY_IMAGE=agentmemory/memory-proxy:latest
