# ── 엣지 (외부 노출 지점) ──
EDGE_PORT=8090
AGENT_SOURCE=codebuddy      # claude-code | codebuddy | workbuddy | codex | hermes | openclaw
                            # BrowserOS 등 목록 밖 클라이언트는 하나를 사칭한다 (공식 문서 권장)
SPACE_ID=default

# ── 커널 인증 ── openssl rand -hex 32
# 비우면 데이터 평면이 "비어있지 않은 아무 Bearer" 나 통과시킨다 (docs/06 F3)
GATEWAY_API_KEY=REPLACE_ME

# ── 상위 LLM (cliproxy) ──
UPSTREAM_BASE=http://10.77.0.4:8317              # 엣지 직결용. /v1 붙이지 말 것
PROXY_UPSTREAM_URL=http://10.77.0.4:8317/v1      # memory-proxy 용. /v1 포함
PROXY_UPSTREAM_API_KEY=REPLACE_ME

# 임베딩 (bge-m3). 한국어는 FTS5 가 음절 단위로 쪼개져 사실상 못 쓰므로
# 벡터 검색이 필수다 (docs/06-M0-RESULT.md F6).
EMBED_BASE_URL=http://127.0.0.1:11434/v1

# ── 상태 저장소 (관리형) ──────────────────────────────────
# 메타데이터 + L0/L1 + 벡터 + Skill 이 전부 여기로 간다.
TURSO_URL=libsql://<db>-<org>.turso.io
TURSO_AUTH_TOKEN=REPLACE_ME

# L2/L3 마크다운 · JSONL · checkpoint · 생성이력.
# Oracle Object Storage / Cloudflare R2 / MinIO 등 S3 호환이면 무엇이든.
S3_ENDPOINT=https://<namespace>.compat.objectstorage.ap-seoul-1.oraclecloud.com
S3_REGION=ap-seoul-1
S3_BUCKET=memory-store
S3_ACCESS_KEY_ID=REPLACE_ME
S3_SECRET_ACCESS_KEY=REPLACE_ME
S3_PREFIX=prod/
# ⚠️ Oracle: 연합(IDCS/SAML) 사용자가 아니라 **로컬 사용자**에 customer secret key 를
#    만들어야 한다. 생성 후 전파에 2분+ 걸린다 (docs/08 참조).

# ── 정체성 ── 엣지가 주입하는 헤더. 클라이언트는 이걸 못 보낸다.
# ⚠️ agentId 를 머신별로 나누면 L2/L3 페르소나가 쪼개진다 (docs/04 §4)
TEAM_ID=
USER_ID=usr-xxxxxxxxx
AGENT_ID=
TASK_ID=

# ── 이미지 ──
MEMORY_CORE_IMAGE=agentmemory/memory-core:latest
MEMORY_PROXY_IMAGE=agentmemory/memory-proxy:latest

# 스냅샷 배치
BACKUP_DIR=/var/backups/memory-stack
BACKUP_KEEP=14

# 배포할 이미지 태그. 기본은 latest(rock/main 최신 빌드).
# 특정 커밋으로 고정하려면 그 커밋의 SHA 를 넣는다 — 롤백은 이 값만 바꾸면 된다.
IMAGE_TAG=latest
