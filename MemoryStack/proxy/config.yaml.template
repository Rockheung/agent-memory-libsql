# MemoryProxy — 기억 계층. 모델 라우팅은 하지 않고 전부 cliproxy 로 넘긴다.
server:
  host: 0.0.0.0
  port: 8096
  forwardTimeoutMs: 600000

# ── 상위 LLM = cliproxy ──
# effort / web_search / 모델 별칭은 전부 cliproxy 가 처리한다.
upstream:
  url: "${PROXY_UPSTREAM_URL}"
  apiKey: "${PROXY_UPSTREAM_API_KEY}"

# ── 메모리 커널 ──
tdai:
  enabled: true
  endpoint: "http://127.0.0.1:8420"
  apiKey: "${GATEWAY_API_KEY}"
  serviceId: "default"
  memory:
    enabled: true
    inject: true
    writeL0: true
    recallL1: true
    injectL2L3: true
    l1Limit: 5
    l2Limit: 3
    timeoutMs: 8000        # oci-ko → dgx 임베딩 경유를 감안해 기본 5s 보다 여유

skill:
  endpoint: "http://127.0.0.1:8420"
  serviceToken: "${GATEWAY_API_KEY}"

auth:
  enabled: true
  url: "http://127.0.0.1:8420"
  timeoutMs: 5000
  # 커널이 TDAI_GATEWAY_API_KEY 를 켰으므로 Bearer 가 필요하다.
  # upstream 은 이 필드가 없어 401 이 난다 (포크에서 추가).
  apiKey: "${GATEWAY_API_KEY}"

# ── 상태 저장: Redis 없이 sqlite 단일 인스턴스 ──
storage:
  enabled: true
  backend: sqlite
  ttlDays: 7

# ── 세션 초기화: 헤더로 팀/에이전트/태스크를 자동 선택 (폼 안 뜸) ──
sessionInit:
  enabled: true
  maxRetries: 3
  injectAgentContext: true
  injectTaskContext: true
  headerAutoSelect:
    enabled: true
    teamHeader: "x-team-id"
    agentHeader: "x-agent-id"
    taskHeader: "x-task-id"
    onMismatch: "form"     # 헤더 값이 커널에 없으면 폼으로 폴백 → 오설정을 조용히 넘기지 않는다

injection:
  enabled: true

extraction:
  enabled: true

log:
  level: info
